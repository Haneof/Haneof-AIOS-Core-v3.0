"""INDEPENDENT ACCEPTANCE reviewer probes -- IA2 (rev1).

Task: CORE-BACKGROUND-TRUSTED-RETURN-RECOVERY-001-CORRECTIVE-001-INDEPENDENT-ACCEPTANCE
Candidate under attack: a73e186d40688f5dc181b1128a62eff37a974409

This suite is written by the Independent Core Runtime Recovery Acceptance
Reviewer.  It does NOT import, reuse or trust the author's rev5/rev6/rev7
matrix, the author's seeding rules, or the author's expected outcomes.  Every
scenario below was derived from the capability ``input_schema`` exposed by the
live registry and from the request models in ``src/aios_core``.

Deliberate differences from the author's harness
------------------------------------------------
* The inventory guard does NOT read ``CapabilitySpec.side_effecting``.  It
  classifies side-effecting capabilities EMPIRICALLY by poisoning the durable
  write primitives and invoking every model-callable capability.  A capability
  that reaches a durable write while declared read-only fails this suite.
* Expectations are frozen before any candidate execution.
"""
from __future__ import annotations

import hashlib
import json
import sqlite3
from dataclasses import dataclass
from datetime import datetime, timedelta, timezone
import pathlib
from pathlib import Path
from typing import Any, Callable, Mapping

import pytest

from aios_core.contracts.enums import ObjectType, SourceClass
from aios_core.contracts.models import Observation
from aios_core.contracts.operations import OperationRequest
from aios_core.contracts.refs import ObjectRef
from aios_core.contracts.time import TemporalExtent
from aios_core.query.search import WorldSearchIndex
from aios_core.review.periodic import PeriodicReviewRequest, ReviewAnchor
from aios_core.runtime.capabilities import CapabilityCall
from aios_core.runtime.turn_runtime import FusedTurnRuntime
from aios_core.storage.sqlite_store import SQLiteWorldStore

# --------------------------------------------------------------------------
# Reviewer's own fixed clock and subject.  A recovered round must reproduce the
# original write time, so identity is stable across replay.
# --------------------------------------------------------------------------
RT = datetime(2026, 9, 28, 9, tzinfo=timezone.utc)
RSUBJECT = "user_ia2"
RLEAF = "ia2-anchor"
RLEAF2 = "ia2-anchor-2"

EXPECTED_MODEL_CALLABLE = 43


# --------------------------------------------------------------------------
# world helpers (reviewer-authored)
# --------------------------------------------------------------------------
def _open(db: Path):
    store = SQLiteWorldStore(db)
    index = WorldSearchIndex(db, store=store)
    index.rebuild()
    return store, index


def fresh_runtime(db: Path) -> FusedTurnRuntime:
    """Brand new runtime over the same durable World == fresh-process semantics."""
    store, index = _open(db)

    def _no_dispatch(_snapshot):  # pragma: no cover
        raise AssertionError("IA2 replay probe must never dispatch a provider")

    return FusedTurnRuntime(store=store, index=index, model_handler=_no_dispatch,
                            subject_id=RSUBJECT)


def seed_leaf(store: SQLiteWorldStore, name: str) -> ObjectRef:
    moment = RT - timedelta(hours=2)
    obs = Observation(
        object_id=f"ia2leaf_{name}",
        subject_id=RSUBJECT,
        occurred=TemporalExtent.point(moment),
        learned_at=moment,
        recorded_at=moment,
        created_by="ia2:seed",
        source_kind="conversation",
        modality="text",
        value=f"reviewer durable reality leaf {name}",
        metadata={"dimension": "dim:ia2"},
    )
    store.commit(
        [obs],
        OperationRequest(
            operation_name="ia2.seed_leaf",
            expected_world_revision=int(store.current_world_revision()),
            reason="seed qualifying reality leaf",
            idempotency_key=f"ia2-seed-leaf-{name}",
            source_class=SourceClass.USER,
        ),
    )
    return ObjectRef(object_id=obs.object_id, revision=1)


def L(name: str = RLEAF) -> dict[str, Any]:
    return {"object_id": f"ia2leaf_{name}", "revision": 1}


def unrelated_revision(db: Path, tag: str) -> None:
    """An unrelated World revision landing inside the crash window."""
    store, _ = _open(db)
    moment = RT + timedelta(minutes=7)
    store.commit(
        [Observation(
            object_id=f"ia2unrelated_{tag}",
            subject_id=RSUBJECT,
            occurred=TemporalExtent.point(moment),
            learned_at=moment,
            recorded_at=moment,
            created_by="ia2:unrelated",
            source_kind="conversation",
            modality="text",
            value=f"unrelated later world revision {tag}",
            metadata={"dimension": "dim:ia2"},
        )],
        OperationRequest(
            operation_name="ia2.unrelated_advance",
            expected_world_revision=int(store.current_world_revision()),
            reason="unrelated later world revision",
            idempotency_key=f"ia2-advance-{tag}",
            source_class=SourceClass.USER,
        ),
    )


def _conn(db: Path):
    conn = sqlite3.connect(db)
    conn.row_factory = sqlite3.Row
    return conn


def durable_digest(db: Path) -> str:
    """Canonical digest over objects + operations + idempotency rows."""
    with _conn(db) as conn:
        objects = [
            (r["object_id"], int(r["revision"]),
             hashlib.sha256(r["payload_json"].encode()).hexdigest())
            for r in conn.execute(
                "SELECT object_id, revision, payload_json FROM object_revisions "
                "ORDER BY object_id, revision")
        ]
        ops = [
            (r["operation_id"], r["operation_name"],
             hashlib.sha256(r["arguments_json"].encode()).hexdigest(),
             int(r["expected_world_revision"]), r["reason"],
             r["idempotency_key"], r["status"], r["result_world_revision"])
            for r in conn.execute("SELECT * FROM operations ORDER BY idempotency_key")
        ]
        idem = [
            (r["idempotency_key"], r["operation_id"], int(r["world_revision"]),
             hashlib.sha256(r["result_json"].encode()).hexdigest())
            for r in conn.execute(
                "SELECT * FROM idempotency_records ORDER BY idempotency_key")
        ]
    return json.dumps({"o": objects, "p": ops, "i": idem}, sort_keys=True)


def op_rows(db: Path) -> list[tuple]:
    with _conn(db) as conn:
        return [(r["operation_id"], r["operation_name"], r["arguments_json"],
                 int(r["expected_world_revision"]), r["idempotency_key"], r["status"])
                for r in conn.execute("SELECT * FROM operations ORDER BY idempotency_key")]


def idem_rows(db: Path) -> list[tuple]:
    with _conn(db) as conn:
        return [(r["idempotency_key"], r["operation_id"], int(r["world_revision"]),
                 r["result_json"])
                for r in conn.execute("SELECT * FROM idempotency_records ORDER BY idempotency_key")]


def revisions_of(db: Path, object_type: ObjectType) -> list[tuple[str, int]]:
    """EVERY durable revision -- list_payloads would hide a duplicate revision."""
    with _conn(db) as conn:
        return sorted((str(r[0]), int(r[1])) for r in conn.execute(
            "SELECT object_id, revision FROM object_revisions WHERE object_type=?",
            (object_type.value,)))


def payloads_of(db: Path, object_type: ObjectType) -> dict[tuple[str, int], str]:
    with _conn(db) as conn:
        return {(str(r[0]), int(r[1])): hashlib.sha256(str(r[2]).encode()).hexdigest()
                for r in conn.execute(
                    "SELECT object_id, revision, payload_json FROM object_revisions "
                    "WHERE object_type=?", (object_type.value,))}


def op_keys(db: Path, prefix: str) -> list[str]:
    with _conn(db) as conn:
        return [str(r[0]) for r in conn.execute(
            "SELECT idempotency_key FROM operations WHERE idempotency_key LIKE ?",
            (f"{prefix}%",))]


def call(rt: FusedTurnRuntime, name: str, arguments: Mapping[str, Any], *,
         call_id: str = "ia2-call-0"):
    """Invoke one capability at the reviewer's stable recovered write time."""
    rt._active_turn_time = RT
    if name == "commit_operation_experience":
        rt._active_review_request = PeriodicReviewRequest(
            review_id="ia2-review",
            subject_id=RSUBJECT,
            wake_ref=ObjectRef(object_id="ia2-review-wake", revision=1),
            window_start=RT - timedelta(hours=2),
            window_end=RT,
            anchors=(ReviewAnchor(
                object_ref=ObjectRef(object_id=f"ia2leaf_{RLEAF}", revision=1),
                object_type=ObjectType.OBSERVATION.value,
                recorded_at=RT - timedelta(hours=2),
                excerpt="ia2 operation-experience anchor",
            ),),
        )
    try:
        return rt.registry.invoke(
            CapabilityCall(name=name, call_id=call_id, arguments=dict(arguments)))
    finally:
        rt._active_turn_time = None
        rt._active_review_request = None


def ref_of(payload: Mapping[str, Any]) -> dict[str, Any]:
    return {"object_id": str(payload["object_id"]), "revision": int(payload["revision"])}


# --------------------------------------------------------------------------
# reviewer-authored capability matrix
# --------------------------------------------------------------------------
@dataclass(frozen=True)
class Row:
    """One reviewer-frozen capability row.

    ``prep`` seeds durable prerequisites and returns the exact arguments.
    ``identity`` is the durable object type whose revision count must not grow
    on an identical replay.  ``non_identity_fields`` are fields that are NOT
    inputs to the durable object id -- the fields whose change the reviewer
    independently classifies.
    """
    name: str
    identity: ObjectType | None
    prep: Callable[[FusedTurnRuntime], dict[str, Any]]
    key_prefix: str
    non_identity_fields: tuple[str, ...] = ()
    family: str = "create"


def _p_entity(rt, key: str, name: str) -> dict[str, Any]:
    r = call(rt, "propose_entity", entity_key=key, entity_kind="concept",
             evidence_refs=[L()], canonical_name=name)
    assert r.ok, f"seed propose_entity {key}: {r.error_code} {r.error_message}"
    return r.data


def _p_policy(rt, policy_id: str, value: int = 1) -> None:
    r = call(rt, "propose_cognitive_policy", policy_id=policy_id, scope="local",
             default_value=value, current_value=value, reason="ia2 seed policy",
             evidence_refs=[L()], evaluation_window="7d")
    assert r.ok, f"seed policy {policy_id}: {r.error_code} {r.error_message}"


def _p_goal(rt, title: str) -> dict[str, Any]:
    r = call(rt, "propose_goal", source_type="user_explicit", title=title,
             description="ia2 seed goal", evidence_refs=[L()], confidence=0.5)
    assert r.ok, f"seed goal {title}: {r.error_code} {r.error_message}"
    return r.data


def _p_task(rt, title: str) -> dict[str, Any]:
    r = call(rt, "create_task", title=title, task_type="immediate",
             reason_refs=[L()], initial_state="draft")
    assert r.ok, f"seed task {title}: {r.error_code} {r.error_message}"
    return r.data


def _p_dimension(rt, key: str) -> dict[str, Any]:
    r = call(rt, "propose_dimension", dimension_key=key, name="IA2 Axis",
             description="ia2 seed axis", data_shape="scalar", evidence_refs=[L()],
             why_existing_dimensions_are_insufficient="none",
             continuity_rationale="c", user_value_rationale="u",
             maintenance_cost_rationale="m", confidence=0.5)
    assert r.ok, f"seed dimension {key}: {r.error_code} {r.error_message}"
    return r.data


def _p_event(rt, title: str) -> dict[str, Any]:
    r = call(rt, "form_event", title=title, interpretation="ia2 seed event",
             event_time=TemporalExtent.point(RT - timedelta(hours=3)).model_dump(mode="json"),
             evidence_refs=[L()], confidence=0.5)
    assert r.ok, f"seed event {title}: {r.error_code} {r.error_message}"
    return r.data


def _p_claim(rt, content: str) -> dict[str, Any]:
    r = call(rt, "commit_claim", content=content, evidence_refs=[L()],
             confidence=0.5, dimension="dim:ia2")
    assert r.ok, f"seed claim {content}: {r.error_code} {r.error_message}"
    return r.data


def _running_task(rt, title: str) -> dict[str, Any]:
    """A task driven to RUNNING so propose_action accepts an external action."""
    task = _p_task(rt, title)
    tr = ref_of(task)
    r = call(rt, "transition_task", task_ref=tr, new_state="ready",
             reason="ia2 seed ready", evidence_refs=[L()])
    assert r.ok, f"seed ready: {r.error_code} {r.error_message}"
    rt.store.index_catch_up() if hasattr(rt.store, "index_catch_up") else None
    ready = rt.store.get_payload(tr["object_id"])
    r = call(rt, "transition_task", task_ref=ref_of(ready), new_state="running",
             reason="ia2 seed running", evidence_refs=[L()])
    assert r.ok, f"seed running: {r.error_code} {r.error_message}"
    return rt.store.get_payload(tr["object_id"])


