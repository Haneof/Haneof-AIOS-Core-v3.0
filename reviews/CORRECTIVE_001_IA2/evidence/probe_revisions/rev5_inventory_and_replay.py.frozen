ROW_BY_NAME = {r.name: r for r in ROWS}


# --------------------------------------------------------------------------
# apply once, durably
# --------------------------------------------------------------------------
def apply_once(db: Path, row: Row):
    rt = fresh_runtime(db)
    seed_leaf(rt.store, RLEAF)
    seed_leaf(rt.store, RLEAF2)
    arguments = row.prep(rt)
    result = call(rt, row.name, arguments)
    assert result.ok, (
        f"{row.name}: first application failed: "
        f"{result.error_code} {result.error_message}")
    return rt, dict(arguments), result.data


# ==========================================================================
# GROUP A -- independent inventory / reachability
# ==========================================================================
class _Poison(Exception):
    """Raised instead of any durable write."""


def _poisoned_runtime(db: Path):
    """A runtime whose durable write primitives raise instead of writing."""
    store, index = _open(db)
    for name in ("commit", "commit_or_replay", "replay_exact_operation"):
        def _boom(*_a, **_k):
            raise _Poison("durable write attempted")
        setattr(store, name, _boom)
    return FusedTurnRuntime(store=store, index=index, model_handler=lambda _s: None,
                            subject_id=RSUBJECT)


def _declared_side_effecting(runtime) -> set[str]:
    return {e["name"] for e in runtime.registry.catalog() if e["side_effecting"]}


def _empirical_durable_writers(db: Path, names: list[str]) -> set[str]:
    """Invoke every capability under poisoned writes; those that raise _Poison
    genuinely reach a durable write, independent of any declaration."""
    writers: set[str] = set()
    # Seed once with real writes, then poison for the classification pass.
    seed_store, _seed_index = _open(db)
    seed_leaf(seed_store, RLEAF)
    for name in names:
        rt = _poisoned_runtime(db)
        rt._active_turn_time = RT
        rt._active_review_request = PeriodicReviewRequest(
            review_id="ia2-review", subject_id=RSUBJECT,
            wake_ref=ObjectRef(object_id="ia2-review-wake", revision=1),
            window_start=RT - timedelta(hours=2), window_end=RT,
            anchors=(ReviewAnchor(
                object_ref=ObjectRef(object_id=f"ia2leaf_{RLEAF}", revision=1),
                object_type=ObjectType.OBSERVATION.value,
                recorded_at=RT - timedelta(hours=2), excerpt="ia2"),),
        )
        try:
            # Empty arguments are sufficient: a read-only handler either returns
            # data or raises a normal validation error.  Only a handler that
            # actually reaches a durable write can raise _Poison.
            try:
                rt.registry.invoke(CapabilityCall(name=name, call_id="ia2", arguments={}))
            except _Poison:
                writers.add(name)
            except Exception:
                pass
        finally:
            rt._active_turn_time = None
            rt._active_review_request = None
    return writers


def test_a1_registry_shape_and_reachability(tmp_path):
    """Independent inventory: registry shape + declared set == authorize set."""
    import ast
    import inspect
    import textwrap

    rt = fresh_runtime(tmp_path / "world.db")
    catalog = rt.registry.catalog()
    assert len(catalog) == EXPECTED_MODEL_CALLABLE, (
        f"model-callable surface changed: {len(catalog)} != {EXPECTED_MODEL_CALLABLE}")

    declared = _declared_side_effecting(rt)

    src = textwrap.dedent(inspect.getsource(type(rt)._authorize_side_effect))
    allow: set[str] = set()
    for node in ast.walk(ast.parse(src)):
        if isinstance(node, ast.Set):
            allow |= {e.value for e in node.elts
                      if isinstance(e, ast.Constant) and isinstance(e.value, str)}
    # the authorizer also unions the C14 allowlist module constant
    import aios_core.runtime.turn_runtime as tr_mod
    allow |= set(tr_mod._C14_COGNITIVE_SIDE_EFFECT_ALLOWLIST)

    assert declared == allow, (
        "declared side-effecting set differs from the runtime's own side-effect "
        f"authorization allowlist: declared-only={sorted(declared-allow)} "
        f"allowlist-only={sorted(allow-declared)}")

    frozen = set(ROW_BY_NAME)
    assert frozen == declared, (
        "reviewer matrix drifted from the live registry: "
        f"registry-only={sorted(declared-frozen)} matrix-only={sorted(frozen-declared)}")


def test_a2_no_read_declared_capability_reaches_a_durable_write(tmp_path):
    """The runtime gate trusts the DECLARED flag (cognitive_runtime.py), so a
    read-declared capability that writes durably would bypass authorization.
    Poison the durable primitives and prove none does."""
    rt = fresh_runtime(tmp_path / "world.db")
    catalog = rt.registry.catalog()
    read_declared = sorted(e["name"] for e in catalog if not e["side_effecting"])
    assert read_declared, "no read-declared capabilities to check"

    writers = _empirical_durable_writers(tmp_path / "probe.db", read_declared)
    assert not writers, (
        "capabilities declared read-only reached a durable write and would "
        f"therefore bypass the side-effect authorizer: {sorted(writers)}")


def test_a3_every_declared_writer_really_writes(tmp_path):
    """Converse control: the poison probe must actually detect writers, so
    test_a2 is not vacuously green."""
    rt = fresh_runtime(tmp_path / "world.db")
    declared = sorted(_declared_side_effecting(rt))
    writers = _empirical_durable_writers(tmp_path / "probe2.db", declared)
    assert writers, "poison probe detected no writers at all -- probe is broken"
    assert len(writers) >= 15, (
        f"poison probe only detected {len(writers)} of {len(declared)} declared "
        f"writers; undetected={sorted(set(declared)-writers)}")


# ==========================================================================
# GROUP B -- exact recovered replay across the complete side-effecting surface
# ==========================================================================
@pytest.mark.parametrize("name", sorted(ROW_BY_NAME))
def test_b_exact_recovery_replay_converges_with_zero_duplicate_effect(tmp_path, name):
    """Side effect durable -> unrelated later World revision -> brand new runtime
    -> identical recovered invocation.

    Required: convergence, no provider redispatch (the runtime's handler raises
    if called), no second meter, no second operation, no second idempotency row,
    no second semantic write, no second object revision, original identity kept.
    """
    row = ROW_BY_NAME[name]
    db = tmp_path / "world.db"
    _rt, arguments, _first = apply_once(db, row)

    # Unrelated World revision lands inside the crash window.
    unrelated_revision(db, f"{name}-b")
    revision_after = int(fresh_runtime(db).store.current_world_revision())

    state_before = durable_digest(db)
    ops_before = op_rows(db)
    idem_before = idem_rows(db)
    rev_before = (revisions_of(db, row.identity) if row.identity else None)

    fresh = fresh_runtime(db)
    replay = call(fresh, name, arguments, call_id="ia2-replay")

    assert replay.ok, (
        f"{name}: identical recovered replay must converge, got "
        f"{replay.error_code}: {replay.error_message}")
    assert durable_digest(db) == state_before, (
        f"{name}: identical replay changed durable state")
    assert int(fresh.store.current_world_revision()) == revision_after, (
        f"{name}: identical replay advanced the World revision")
    assert op_rows(db) == ops_before, f"{name}: identical replay added an operation"
    assert idem_rows(db) == idem_before, (
        f"{name}: identical replay changed the idempotency record")
    if row.identity is not None:
        assert revisions_of(db, row.identity) == rev_before, (
            f"{name}: identical replay produced a second durable revision")


@pytest.mark.parametrize("name", sorted(ROW_BY_NAME))
def test_b2_exact_replay_result_is_the_original_result(tmp_path, name):
    """A converged replay must return the ORIGINAL durable identity, not a
    freshly minted one.  A replay that reports a new object/revision has not
    actually replayed."""
    row = ROW_BY_NAME[name]
    db = tmp_path / "world.db"
    _rt, arguments, first = apply_once(db, row)
    unrelated_revision(db, f"{name}-b2")

    fresh = fresh_runtime(db)
    replay = call(fresh, name, arguments, call_id="ia2-replay2")
    assert replay.ok, f"{name}: replay must converge: {replay.error_code}"

    def _ids(data):
        out = []
        stack = [data]
        while stack:
            node = stack.pop()
            if isinstance(node, dict):
                for k, v in node.items():
                    if k in {"object_id", "revision", "relation_id", "policy_id",
                             "goal_id", "task_id", "action_id", "event_id",
                             "entity_id", "dimension_id", "claim_id", "watch_id"}:
                        out.append((k, v))
                    stack.append(v)
            elif isinstance(node, list):
                stack.extend(node)
        return sorted((k, str(v)) for k, v in out)

    assert _ids(replay.data) == _ids(first), (
        f"{name}: replay reported different durable identities than the original.\n"
        f"  original={_ids(first)}\n  replay  ={_ids(replay.data)}")


# ==========================================================================
# GROUP C -- the four concepts the adjudication requires kept separate
# ==========================================================================
def _seeded_store(db: Path) -> SQLiteWorldStore:
    store, index = _open(db)
    seed_leaf(store, RLEAF)
    return store


def test_c1_same_durable_key_plus_changed_request_fails_closed(tmp_path):
    """CONCEPT 1: same durable idempotency key + changed request => FAIL CLOSED.

    Attacked directly at the store layer, where the guarantee must live
    regardless of which service produced the key.
    """
    from aios_core.storage.sqlite_store import StoreError

    db = tmp_path / "world.db"
    store = _seeded_store(db)
    moment = RT - timedelta(hours=1)
    obs = Observation(
        object_id="ia2_c1_obj", subject_id=RSUBJECT,
        occurred=TemporalExtent.point(moment), learned_at=moment, recorded_at=moment,
        created_by="ia2:c1", source_kind="conversation", modality="text",
        value="c1 original", metadata={"dimension": "dim:ia2"})
    key = "ia2-c1-key"
    op = OperationRequest(
        operation_name="ia2.c1", arguments={"request": "original"},
        expected_world_revision=int(store.current_world_revision()),
        reason="c1", idempotency_key=key, source_class=SourceClass.USER)
    first = store.commit([obs], op)
    assert not first.idempotent_replay

    before = durable_digest(db)

    changed = op.model_copy(update={"arguments": {"request": "CHANGED"}})
    with pytest.raises(StoreError) as exc:
        store.commit_or_replay([obs], changed)
    assert exc.value.code.name == "IDEMPOTENCY_CONFLICT", exc.value.code
    assert durable_digest(db) == before, "a rejected changed request still wrote"

    # and the replay helper alone must not have written either
    assert store.replay_exact_operation(changed) is None or True
    assert durable_digest(db) == before


def test_c1b_replay_helper_rejects_changed_request_with_zero_writes(tmp_path):
    """`replay_exact_operation()` itself must fail closed on a changed request
    under an existing key, and must not persist anything."""
    from aios_core.storage.sqlite_store import StoreError

    db = tmp_path / "world.db"
    store = _seeded_store(db)
    moment = RT - timedelta(hours=1)
    obs = Observation(
        object_id="ia2_c1b_obj", subject_id=RSUBJECT,
        occurred=TemporalExtent.point(moment), learned_at=moment, recorded_at=moment,
        created_by="ia2:c1b", source_kind="conversation", modality="text",
        value="c1b original", metadata={"dimension": "dim:ia2"})
    op = OperationRequest(
        operation_name="ia2.c1b", arguments={"request": "original"},
        expected_world_revision=int(store.current_world_revision()),
        reason="c1b", idempotency_key="ia2-c1b-key", source_class=SourceClass.USER)
    store.commit([obs], op)
    before = durable_digest(db)

    changed = op.model_copy(update={"arguments": {"request": "TAMPERED"}})
    with pytest.raises(StoreError) as exc:
        store.replay_exact_operation(changed)
    assert exc.value.code.name == "IDEMPOTENCY_CONFLICT", exc.value.code
    assert durable_digest(db) == before


def test_c2_call_id_grants_no_durable_identity_or_authority(tmp_path):
    """CONCEPT 3: `call_id` is correlation only.

    Independently verified from the Core contract, NOT from the author's test
    description: call_id must not appear in any durable identity, and reusing a
    call_id with different arguments must not replay the original result.
    """
    import ast
    import inspect
    from pathlib import Path as _P

    import aios_core
    src_root = _P(aios_core.__file__).resolve().parent

    # (a) call_id is absent from the storage identity module entirely
    idem_src = (src_root / "storage" / "idempotency.py").read_text(encoding="utf-8")
    assert "call_id" not in idem_src, (
        "call_id participates in durable request identity -- contradicts the "
        "correlation-only classification")

    # (b) call_id never contributes to any idempotency key construction
    offenders = []
    for path in sorted(src_root.rglob("*.py")):
        text = path.read_text(encoding="utf-8")
        if "idempotency_key" not in text:
            continue
        for node in ast.walk(ast.parse(text)):
            if not isinstance(node, ast.keyword) or node.arg != "idempotency_key":
                continue
            for sub in ast.walk(node.value):
                if isinstance(sub, ast.Attribute) and sub.attr == "call_id":
                    offenders.append(str(path.relative_to(src_root)))
                if isinstance(sub, ast.Name) and sub.id == "call_id":
                    offenders.append(str(path.relative_to(src_root)))
    assert not offenders, f"call_id feeds an idempotency key in: {sorted(set(offenders))}"

    # (c) behavioural: same call_id, different arguments -> NOT a replay of the
    #     original.  The second call is judged purely by its request identity.
    db = tmp_path / "world.db"
    rt = fresh_runtime(db)
    seed_leaf(rt.store, RLEAF)
    r1 = call(rt, "propose_entity",
              dict(entity_key="entity:ia2-c2", entity_kind="concept",
                   evidence_refs=[L()], canonical_name="C2 First"),
              call_id="SAME-CALL-ID")
    assert r1.ok, f"{r1.error_code} {r1.error_message}"
    r2 = call(rt, "propose_entity",
              dict(entity_key="entity:ia2-c2", entity_kind="concept",
                   evidence_refs=[L()], canonical_name="C2 DIFFERENT"),
              call_id="SAME-CALL-ID")
    # same entity_key => same durable object; the changed request must not be
    # silently reported as the original operation.
    assert r1.data["entity_id"] == r2.data["entity_id"]
    assert r1.data["revision"] != r2.data["revision"], (
        "a changed request under a reused call_id was silently replayed as the "
        "original operation; call_id must not authorize a replay")


@pytest.mark.parametrize("name", sorted(
    n for n, r in ROW_BY_NAME.items() if r.non_identity_fields))
def test_c4_changed_non_identity_request_is_a_distinct_operation_never_an_overwrite(
        tmp_path, name):
    """CONCEPT 4: a changed request that yields a new canonical request identity.

    The reviewer's own verdict on the rev5->rev6 question is decided by these
    assertions, which are STRICTER than either author class:
      * the original durable object revision must survive byte-for-byte;
      * the original operation row must survive byte-for-byte;
      * success is only acceptable if it produced a genuinely NEW durable
        identity (new key AND new revision), never a silent overwrite and never
        a report of the original identity.
    """
    row = ROW_BY_NAME[name]
    db = tmp_path / "world.db"
    _rt, arguments, first = apply_once(db, row)
    unrelated_revision(db, f"{name}-c4")

    original_payloads = payloads_of(db, row.identity)
    original_ops = op_rows(db)
    original_keys = set(op_keys(db, row.key_prefix))
    assert original_keys, f"{name}: no operation key with prefix {row.key_prefix!r}"

    field = row.non_identity_fields[0]
    changed = dict(arguments)
    current = changed.get(field)
    if isinstance(current, str):
        changed[field] = current + "-ia2-changed"
    elif isinstance(current, (int, float)):
        changed[field] = current + 1
    elif isinstance(current, list):
        changed[field] = list(current) + [L(RLEAF2)]
    elif isinstance(current, dict):
        changed[field] = {**current, "ia2": "changed"}
    else:
        changed[field] = "ia2-changed"
    assert changed != arguments, f"{name}/{field}: mutation was a no-op"

    fresh = fresh_runtime(db)
    result = call(fresh, name, changed, call_id=f"ia2-c4-{name}")

    new_payloads = payloads_of(db, row.identity)
    new_ops = op_rows(db)
    new_keys = set(op_keys(db, row.key_prefix))

    # 1. the original durable object revisions are untouched, byte for byte
    for ident, digest in original_payloads.items():
        assert ident in new_payloads, (
            f"{name}/{field}: original revision {ident} disappeared")
        assert new_payloads[ident] == digest, (
            f"{name}/{field}: original revision {ident} was overwritten by a "
            f"changed request")

    # 2. the original operation rows are untouched, byte for byte
    for op in original_ops:
        assert op in new_ops, f"{name}/{field}: original operation row changed"

    # 3. original idempotency keys were not reused for the changed request
    assert original_keys <= new_keys

    if result.ok:
        # success is only legitimate as a genuinely NEW durable operation
        added_keys = new_keys - original_keys
        assert added_keys, (
            f"{name}/{field}: a changed request succeeded while REUSING the "
            f"original idempotency key {sorted(original_keys)} -- that is a "
            f"silent replay of the original operation")
        added_revisions = set(new_payloads) - set(original_payloads)
        assert added_revisions, (
            f"{name}/{field}: a changed request succeeded without a new durable "
            f"revision -- it neither replayed nor created, so the reported "
            f"success is not backed by durable state")
    else:
        # fail closed is always acceptable, and must not have written
        for ident, digest in original_payloads.items():
            assert new_payloads[ident] == digest

# ==========================================================================
# GUARD -- the probes must execute the intended checkout, not some other tree.
# A reviewer harness that silently imports the wrong tree produces fake RED.
# (This exact failure occurred during this review: pytest resolved aios_core to
# the live-main checkout because the probe file lives under the main repo.)
# ==========================================================================
TARGET_SRC_MARKER = "/home/user/wt/candidate/src"


def test_z00_probes_execute_the_intended_tree():
    import aios_core

    loaded = str(pathlib.Path(aios_core.__file__).resolve())
    assert loaded.startswith(TARGET_SRC_MARKER), (
        f"reviewer probes imported aios_core from {loaded}, NOT from the "
        f"intended checkout {TARGET_SRC_MARKER}; every other result in this run "
        f"would be meaningless")


def test_z01_loaded_tree_is_the_corrective_candidate():
    """Expected RED on the failed historical exact 1ebf51c4 (it lacks the fix)."""
    import aios_core.world_graph as wg

    assert hasattr(SQLiteWorldStore, "replay_exact_operation"), (
        "loaded tree lacks SQLiteWorldStore.replay_exact_operation")
    assert hasattr(SQLiteWorldStore, "commit_or_replay"), (
        "loaded tree lacks SQLiteWorldStore.commit_or_replay")
    assert "replay_exact_operation" in pathlib.Path(wg.__file__).read_text(), (
        "loaded world_graph never calls replay_exact_operation")
