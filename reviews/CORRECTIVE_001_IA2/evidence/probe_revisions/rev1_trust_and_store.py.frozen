def test_e10_reused_operation_identity_under_another_key_fails_closed(tmp_path):
    db = tmp_path / "w.db"
    store, _ = _open(db)
    op = _op("ia2-e10").model_copy(
        update={"expected_world_revision": int(store.current_world_revision())})
    first = store.commit([_obs("ia2_e10", "v1")], op)
    other = _op("ia2-e10-other").model_copy(update={
        "operation_id": first.operation_id,
        "expected_world_revision": int(store.current_world_revision()),
    })
    with pytest.raises(StoreError):
        store.commit_or_replay([_obs("ia2_e10_other", "v2")], other)


def test_e11_expected_world_revision_is_still_part_of_request_identity():
    """The corrective must not have dropped expected_world_revision from the
    fingerprint contract."""
    src = pathlib.Path(inspect.getsourcefile(request_fingerprint)).read_text()
    body = src[src.index("def request_fingerprint("):]
    body = body[:body.index("\ndef ")]
    assert "expected_world_revision" in body, (
        "expected_world_revision was removed from request_fingerprint")
    for field in ("operation_id", "session_id", "operation_name", "arguments",
                  "reason", "idempotency_key", "objects"):
        assert field in body, f"{field} was dropped from request_fingerprint"


def test_e12_replay_never_persists_caller_supplied_objects(tmp_path):
    """A replay rebuilds objects from durable state; caller bytes must not leak
    into the durable payload even though the request is identical."""
    db = tmp_path / "w.db"
    store, _ = _open(db)
    op = _op("ia2-e12").model_copy(
        update={"expected_world_revision": int(store.current_world_revision())})
    store.commit([_obs("ia2_e12", "ORIGINAL")], op)

    tampered = _obs("ia2_e12", "SMUGGLED-BY-CALLER")
    replay = store.commit_or_replay([tampered], op)
    assert replay.idempotent_replay is True
    with _conn(db) as c:
        rows = [r[0] for r in c.execute(
            "SELECT payload_json FROM object_revisions WHERE object_id='ia2_e12'")]
    assert all("SMUGGLED-BY-CALLER" not in r for r in rows), (
        "a replay persisted caller-supplied object bytes")
    assert any("ORIGINAL" in r for r in rows)


def test_e13_unrelated_later_world_revision_does_not_break_exact_replay(tmp_path):
    db = tmp_path / "w.db"
    store, _ = _open(db)
    op = _op("ia2-e13").model_copy(
        update={"expected_world_revision": int(store.current_world_revision())})
    first = store.commit([_obs("ia2_e13", "v1")], op)
    later = _op("ia2-e13-unrelated", args={"request": "unrelated"},
                reason="unrelated").model_copy(
        update={"expected_world_revision": int(store.current_world_revision())})
    store.commit([_obs("ia2_e13_unrelated", "noise")], later)

    replay = store.commit_or_replay([_obs("ia2_e13", "v1")], op)
    assert replay.idempotent_replay is True
    assert replay.world_revision == first.world_revision
    assert replay.operation_id == first.operation_id
