            },
            {
              "dimension": "dim:production_state",
              "excerpt": "orders-v1 \u4ecd\u5b58\u5728\uff1b\u5ba1\u8ba1\u7cfb\u7edf\u767b\u8bb0\u660e\u5929 09:00 \u8bfb\u53d6\u8be5\u7d22\u5f15\u7684\u5386\u53f2\u8bb0\u5f55\u3002\u5f53\u524d\u6ca1\u6709 production delete authorization \u8bb0\u5f55\uff0c\u4e5f\u6ca1\u6709\u56de\u6eda\u5feb\u7167\u5b8c\u6210\u8bb0\u5f55\u3002",
