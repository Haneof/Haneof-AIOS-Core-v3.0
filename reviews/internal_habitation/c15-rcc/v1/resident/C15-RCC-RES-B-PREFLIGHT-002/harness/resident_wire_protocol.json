{
  "action_enum": [
    "invoke_capability",
    "end_turn",
    "silence",
    "summary_response"
  ],
  "actions": {
    "end_turn": {
      "allowlist": [
        "round",
        "request_id",
        "request_digest",
        "action",
        "response"
      ],
      "fields": {
        "response": {
          "description": "Non-empty resident response if present",
          "type": "string"
        }
      },
      "required": [
        "round",
        "request_id",
        "request_digest",
        "action"
      ]
    },
    "invoke_capability": {
      "allowlist": [
        "round",
        "request_id",
        "request_digest",
        "action",
        "capability",
        "arguments"
      ],
      "fields": {
        "arguments": {
          "description": "Capability arguments, validated by Core capability registry",
          "type": "object"
        },
        "capability": {
          "enum": [
            "search_world",
            "read_world",
            "list_world_subjects",
            "search_memory",
            "read_artifact",
            "query_world_graph"
          ],
          "type": "string"
        }
      },
      "required": [
        "round",
        "request_id",
        "request_digest",
        "action",
        "capability",
        "arguments"
      ]
    },
    "silence": {
      "allowlist": [
        "round",
        "request_id",
        "request_digest",
        "action"
      ],
      "required": [
        "round",
        "request_id",
        "request_digest",
        "action"
      ]
    },
    "summary_response": {
      "allowlist": [
        "round",
        "request_id",
        "request_digest",
        "action",
        "response",
        "summary"
      ],
      "required": [
        "round",
        "request_id",
        "request_digest",
        "action"
      ]
    }
  },
  "binding_fields": {
    "request_digest": {
      "description": "SHA-256 canonical digest of envelope without digest, must be echoed exactly",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "request_id": {
      "description": "32 hex nonce assigned by operator, must be echoed exactly",
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    },
    "round": {
      "description": "Must exactly equal outstanding round assigned by operator",
      "minimum": 1,
      "type": "integer"
    }
  },
  "description": "Purely mechanical JSON schema for Resident B model output. No semantic hints, no expected answer, no fixture knowledge.",
  "forbidden": [
    "fixture",
    "evaluator",
    "expected_answer",
    "keyword_hint",
    "future_cursor",
    "governance_prompt"
  ],
  "notes": "This schema is purely mechanical. It does not contain fixture hints, expected answers, evaluator semantics, or cursor future knowledge. Resident semantic decision ownership remains unchanged. Contract RESIDENT_B_RUN_CONTRACT.md remains the sole semantic instruction.",
  "protocol_name": "C15-RCC-RES-B Resident Wire Protocol",
  "version": "1.0.0"
}