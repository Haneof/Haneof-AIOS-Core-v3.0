SCENARIO_BY_NAME = {scenario.name: scenario for scenario in SCENARIOS}


# --------------------------------------------------------------------------- #
# dynamic inventory guard
# --------------------------------------------------------------------------- #
def test_side_effecting_capability_inventory_is_fully_enumerated(tmp_path):
    """The registry is the authoritative source; the matrix must cover all of it."""
    runtime = new_runtime(tmp_path / "world.db")
    catalog = runtime.registry.catalog()
    reachable = sorted(item["name"] for item in catalog if item["side_effecting"])
    frozen = sorted(SCENARIO_BY_NAME)
    assert reachable == frozen, (
        "capability replay matrix drifted from the live registry; "
        f"registry-only={sorted(set(reachable) - set(frozen))} "
        f"matrix-only={sorted(set(frozen) - set(reachable))}"
    )
    assert len(reachable) >= 20, "unexpectedly small side-effecting surface"


# --------------------------------------------------------------------------- #
# seeding
# --------------------------------------------------------------------------- #
def _seed(rt: FusedTurnRuntime, leaf: str, **kwargs) -> None:
    """Apply a prerequisite side effect durably at the same stable write time."""
    result = invoke(rt, leaf, kwargs)
    assert result.ok, f"seed {leaf} failed: {result.error_code} {result.error_message}"


def seed_for(scenario_name: str, rt: FusedTurnRuntime) -> None:
    """Seed the durable prerequisites that ``scenario_name`` mutates."""
    if scenario_name in {"create_attention_watch", "create_task", "commit_claim",
                         "commit_ai_world_claim", "propose_entity", "propose_dimension",
                         "propose_goal", "form_event", "propose_cognitive_policy",
                         "commit_operation_experience", "record_communication_experience"}:
        return

    leaf = LEAF

    if scenario_name == "revise_entity":
        _seed(rt, "propose_entity", entity_key="entity:revise-seed", entity_kind="concept",
              evidence_refs=[leaf_ref(leaf)], canonical_name="Seed Entity")
    elif scenario_name == "upsert_relation":
        _seed(rt, "propose_entity", entity_key="entity:relation-left", entity_kind="concept",
              evidence_refs=[leaf_ref(leaf)], canonical_name="Left Entity")
        _seed(rt, "propose_entity", entity_key="entity:relation-right", entity_kind="concept",
              evidence_refs=[leaf_ref(leaf)], canonical_name="Right Entity")
    elif scenario_name == "transition_dimension":
        _seed(rt, "propose_dimension", dimension_key="dim:transition_seed", name="Seed Axis",
              description="seed axis", data_shape="scalar", evidence_refs=[leaf_ref(leaf)],
              why_existing_dimensions_are_insufficient="none", continuity_rationale="c",
              user_value_rationale="u", maintenance_cost_rationale="m", confidence=0.5)
    elif scenario_name == "transition_goal":
        _seed(rt, "propose_goal", source_type="user_explicit", title="transition-goal-seed",
              description="seed goal", evidence_refs=[leaf_ref(leaf)], confidence=0.5)
    elif scenario_name == "transition_task":
        _seed(rt, "create_task", title="transition-task-seed", task_type="immediate",
              reason_refs=[leaf_ref(leaf)], initial_state="draft")
    elif scenario_name == "propose_action":
        _seed(rt, "create_task", title="action-task-seed", task_type="immediate",
              reason_refs=[leaf_ref(leaf)], initial_state="draft")
        task = [
            p for p in rt.store.list_payloads(object_type=ObjectType.TASK, subject_id=SUBJECT)
            if p.get("title") == "action-task-seed"
        ][0]
        task_ref = ref(task)
        # Propose an external Action only for a RUNNING, non-world-evidence Task.
        _seed(rt, "transition_task", task_ref=task_ref, new_state="ready",
              reason="seed ready", evidence_refs=[leaf_ref(leaf)])
        ready = rt.store.get_payload(task_ref["object_id"])
        _seed(rt, "transition_task", task_ref=ref(ready), new_state="running",
              reason="seed running", evidence_refs=[leaf_ref(leaf)])
    elif scenario_name in {"revise_claim", "retract_claim"}:
        content = f"{scenario_name}-seed"
        _seed(rt, "commit_claim", content=content, evidence_refs=[leaf_ref(leaf)],
              confidence=0.5, dimension="dim:corrective001")
    elif scenario_name == "transition_event":
        _seed(rt, "form_event", title="transition-event-seed", interpretation="seed event",
              event_time=TemporalExtent.point(T - timedelta(hours=3)).model_dump(mode="json"),
              evidence_refs=[leaf_ref(leaf)], confidence=0.5)
    elif scenario_name in {"update_cognitive_policy", "rollback_cognitive_policy"}:
        policy_id = f"{scenario_name.split('_')[0]}-policy-seed"
        _seed(rt, "propose_cognitive_policy", policy_id=policy_id, scope="local",
              default_value=1, current_value=1, reason="seed policy",
              evidence_refs=[leaf_ref(leaf)], evaluation_window="7d")
        if scenario_name == "rollback_cognitive_policy":
            _seed(rt, "update_cognitive_policy", policy_id=policy_id, current_value=2,
                  reason="seed policy update", evidence_refs=[leaf_ref(leaf)])
    else:  # pragma: no cover - guard against an unseeded new scenario
        raise AssertionError(f"no seeding rule for capability {scenario_name!r}")


def apply_scenario(
    db: Path, scenario: Scenario
) -> tuple[FusedTurnRuntime, dict[str, Any], Any]:
    """Seed prerequisites and apply the capability once, durably."""
    rt = new_runtime(db)
    seed_reality_leaf(rt.store, LEAF)
    seed_reality_leaf(rt.store, OTHER_LEAF)
    seed_for(scenario.name, rt)
    arguments = scenario.prepare(rt)
    result = invoke(rt, scenario.name, arguments)
    assert result.ok, (
        f"{scenario.name} first application failed: "
        f"{result.error_code} {result.error_message}"
    )
    return rt, arguments, result.data


# --------------------------------------------------------------------------- #
# exact identical recovery replay
# --------------------------------------------------------------------------- #
@pytest.mark.parametrize("scenario_name", sorted(SCENARIO_BY_NAME))
def test_exact_recovery_replay_converges_without_duplicate_durable_effect(tmp_path, scenario_name):
    scenario = SCENARIO_BY_NAME[scenario_name]
    db = tmp_path / "world.db"
    rt, arguments, _first = apply_scenario(db, scenario)

    # The crash window: an unrelated World revision lands after the side effect.
    advance_world(db, scenario_name)
    revision_after_advance = int(world(db)[0].current_world_revision())
    state_after_advance = durable_state(db)

    # Baselines are taken AFTER the unrelated advance so that only the replay
    # itself can account for any difference.
    identity_before = (
        object_revisions(db, scenario.identity) if scenario.identity is not None else None
    )
    operations_before = operation_rows(db)
    idempotency_before = idempotency_rows(db)

    # Fresh process, identical recovered capability call, identical write time.
    fresh = new_runtime(db)
    replay = invoke(fresh, scenario_name, arguments, call_id="corrective-replay")

    assert replay.ok, (
        f"{scenario_name}: identical recovered replay must converge, got "
        f"{replay.error_code}: {replay.error_message}"
    )
    assert durable_state(db) == state_after_advance, (
        f"{scenario_name}: identical replay created or mutated durable state"
    )
    assert int(fresh.store.current_world_revision()) == revision_after_advance, (
        f"{scenario_name}: identical replay advanced the World revision"
    )
    assert operation_rows(db) == operations_before, (
        f"{scenario_name}: identical replay added or changed an operation row"
    )
    assert idempotency_rows(db) == idempotency_before, (
        f"{scenario_name}: identical replay changed the idempotency record"
    )
    if scenario.identity is not None:
        assert object_revisions(db, scenario.identity) == identity_before, (
            f"{scenario_name}: identical replay produced a second durable revision"
        )


# --------------------------------------------------------------------------- #
# changed / conflicting replay must stay fail closed
# --------------------------------------------------------------------------- #
def _primary_id(data: Any, path: Sequence[str]) -> str:
    node = data
    for part in path:
        node = node[part]
    return str(node)


@pytest.mark.parametrize(
    "scenario_name",
    sorted(name for name in SCENARIO_BY_NAME if SCENARIO_BY_NAME[name].conflicts),
)
def test_changed_request_under_same_key_fails_closed(tmp_path, scenario_name):
    """Same durable idempotency key + changed request => fail closed, no write."""
    scenario = SCENARIO_BY_NAME[scenario_name]
    db = tmp_path / "world.db"
    _rt, arguments, _first = apply_scenario(db, scenario)
    advance_world(db, f"{scenario_name}-conflict")
    state_before = durable_state(db)

    for label, mutation in scenario.conflicts:
        changed = mutation(dict(arguments))
        assert changed != arguments, f"{scenario_name}/{label}: mutation is a no-op"
        fresh = new_runtime(db)
        result = invoke(fresh, scenario_name, changed, call_id=f"conflict-{label}")
        assert not result.ok, (
            f"{scenario_name}/{label}: a changed request under the same idempotency "
            f"key must fail closed, but reported success {result.data!r}"
        )
        assert durable_state(db) == state_before, (
            f"{scenario_name}/{label}: a rejected replay still wrote durable state"
        )


@pytest.mark.parametrize(
    "scenario_name",
    sorted(name for name in SCENARIO_BY_NAME if SCENARIO_BY_NAME[name].identity_shifts),
)
def test_identity_changing_request_is_never_conflated_with_the_original(tmp_path, scenario_name):
    """A request that changes the deterministic object id is a different object.

    It must never be reported as, or silently overwrite, the original durable
    object produced by the first application.
    """
    scenario = SCENARIO_BY_NAME[scenario_name]
    db = tmp_path / "world.db"
    _rt, arguments, first_data = apply_scenario(db, scenario)
    original_id = _primary_id(first_data, scenario.primary)
    original_digests = object_digests(db, scenario.identity)

    advance_world(db, f"{scenario_name}-identity")

    for label, mutation in scenario.identity_shifts:
        changed = mutation(dict(arguments))
        assert changed != arguments, f"{scenario_name}/{label}: mutation is a no-op"
        # Captured per iteration: an earlier identity shift legitimately creates
        # its own distinct durable object, which must not be attributed to this one.
        state_before_attempt = durable_state(db)
        digests_before_attempt = object_digests(db, scenario.identity)
        fresh = new_runtime(db)
        result = invoke(fresh, scenario_name, changed, call_id=f"identity-{label}")
        digests_after = object_digests(db, scenario.identity)
        overwritten = {
            key: (before, digests_after.get(key))
            for key, before in original_digests.items()
            if digests_after.get(key) != before
        }
        assert not overwritten, (
            f"{scenario_name}/{label}: the original durable object was overwritten: "
            f"{sorted(overwritten)[:2]}"
        )
        if result.ok:
            assert _primary_id(result.data, scenario.primary) != original_id, (
                f"{scenario_name}/{label}: a different logical request was reported "
                f"as the original durable object {original_id}"
            )
            assert set(digests_after) - set(digests_before_attempt), (
                f"{scenario_name}/{label}: success was reported without a new "
                "durable identity, i.e. the original object was silently reused"
            )
        else:
            # A rejection is acceptable here; silently reusing the original is not.
            assert durable_state(db) == state_before_attempt, (
                f"{scenario_name}/{label}: a rejected request still wrote durable state"
            )
