"""CORE-BACKGROUND-TRUSTED-RETURN-RECOVERY-001-CORRECTIVE-001 frozen probes.

Binding blocker under correction: ``IA-BLK-TRUSTED-RETURN-001``.

R5-C requires EXACTLY-ONCE DURABLE EFFECT for an identical recovered capability
invocation. The frozen contract probed here, for every actually reachable
side-effecting capability enumerated from the live runtime registry:

  1. capability side effect is durable;
  2. the outer model round / logical turn completion is NOT durable;
  3. an unrelated later World revision is committed (so ``current_world_revision``
     has advanced exactly as it does in a real crash window);
  4. a brand new runtime replays the identical capability call at the identical
     recovered write time.

Expected corrective result:

  * the replay reports success;
  * no second durable object revision anywhere in the World;
  * no second operation row and no changed idempotency record;
  * the stable object/revision identity is unchanged;
  * the World revision is unchanged by the replay.

Expected result for a CHANGED/conflicting replay: fail closed, with no durable
write. Nothing here weakens ``request_fingerprint``.

The capability inventory is enumerated from ``FusedTurnRuntime.registry.catalog()``;
the matrix guard test fails if the registry and this frozen matrix ever diverge.
"""
from __future__ import annotations

import hashlib
import json
import sqlite3
from dataclasses import dataclass, field
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any, Callable, Mapping, Sequence

import pytest

from aios_core.contracts.enums import ObjectType, SourceClass
from aios_core.contracts.models import Observation
from aios_core.contracts.operations import OperationRequest
from aios_core.contracts.refs import ObjectRef
from aios_core.contracts.time import TemporalExtent
from aios_core.query.search import WorldSearchIndex
from aios_core.review.periodic import PeriodicReviewRequest, ReviewAnchor
from aios_core.runtime.capabilities import CapabilityCall
from aios_core.runtime.turn_runtime import FusedTurnRuntime
from aios_core.storage.sqlite_store import SQLiteWorldStore

# The recovered write time. run_turn uses ``occurred_at``; run_wake /
# run_periodic_review use ``recovered_attempt.admitted_at``. All three modes
# therefore reproduce the original write time for a recovered round, which is what
# makes durable object identity and the canonical request identity stable.
T = datetime(2026, 9, 28, 6, tzinfo=timezone.utc)
SUBJECT = "user_1"
# One canonical qualifying reality leaf per probe World. A second leaf exists
# only so the changed-evidence attack can cite different (but real) evidence.
LEAF = "corrective001-anchor"
OTHER_LEAF = "corrective001-other-anchor"


# --------------------------------------------------------------------------- #
# world / runtime helpers
# --------------------------------------------------------------------------- #
def world(db: Path):
    store = SQLiteWorldStore(db)
    index = WorldSearchIndex(db, store=store)
    index.rebuild()
    return store, index


def new_runtime(db: Path) -> FusedTurnRuntime:
    """A brand new runtime over the same durable World (fresh-process semantics)."""
    store, index = world(db)

    def provider(_snapshot):  # pragma: no cover - matrix probes never dispatch
        raise AssertionError("capability matrix probe must not dispatch a provider")

    return FusedTurnRuntime(store=store, index=index, model_handler=provider)


def seed_reality_leaf(store: SQLiteWorldStore, name: str, *, at: datetime = T) -> ObjectRef:
    """Commit a qualifying reality Observation (USER source class, non-assistant)."""
    moment = at - timedelta(hours=2)
    observation = Observation(
        object_id=f"leaf_{name}",
        subject_id=SUBJECT,
        occurred=TemporalExtent.point(moment),
        learned_at=moment,
        recorded_at=moment,
        created_by="corrective001:seed",
        source_kind="conversation",
        modality="text",
        value=f"durable reality leaf for {name}",
        metadata={"dimension": "dim:corrective001"},
    )
    store.commit(
        [observation],
        OperationRequest(
            operation_name="corrective001.seed_leaf",
            expected_world_revision=int(store.current_world_revision()),
            reason="seed qualifying reality leaf",
            idempotency_key=f"corrective001-seed-leaf-{name}",
            source_class=SourceClass.USER,
        ),
    )
    return ObjectRef(object_id=observation.object_id, revision=1)


def leaf_ref(name: str) -> dict[str, Any]:
    return {"object_id": f"leaf_{name}", "revision": 1}


def advance_world(db: Path, tag: str) -> None:
    """Commit an unrelated World revision inside the crash window."""
    store, _index = world(db)
    moment = T + timedelta(minutes=5)
    store.commit(
        [
            Observation(
                object_id=f"unrelated_{tag}",
                subject_id=SUBJECT,
                occurred=TemporalExtent.point(moment),
                learned_at=moment,
                recorded_at=moment,
                created_by="corrective001:unrelated",
                source_kind="conversation",
                modality="text",
                value=f"unrelated later world revision {tag}",
                metadata={"dimension": "dim:corrective001"},
            )
        ],
        OperationRequest(
            operation_name="corrective001.unrelated_advance",
            expected_world_revision=int(store.current_world_revision()),
            reason="unrelated later world revision",
            idempotency_key=f"corrective001-advance-{tag}",
            source_class=SourceClass.USER,
        ),
    )


def durable_state(db: Path) -> str:
    """Canonical digest of every durable World/operation/idempotency row."""
    with sqlite3.connect(db) as conn:
        conn.row_factory = sqlite3.Row
        objects = [
            (r["object_id"], int(r["revision"]), hashlib.sha256(r["payload_json"].encode()).hexdigest())
            for r in conn.execute(
                "SELECT object_id, revision, payload_json FROM object_revisions "
                "ORDER BY object_id, revision"
            )
        ]
        operations = [
            (
                r["operation_id"],
                r["operation_name"],
                hashlib.sha256(r["arguments_json"].encode()).hexdigest(),
                int(r["expected_world_revision"]),
                r["reason"],
                r["idempotency_key"],
                r["status"],
                r["result_world_revision"],
            )
            for r in conn.execute(
                "SELECT * FROM operations ORDER BY idempotency_key"
            )
        ]
        idem = [
            (
                r["idempotency_key"],
                r["operation_id"],
                int(r["world_revision"]),
                hashlib.sha256(r["result_json"].encode()).hexdigest(),
            )
            for r in conn.execute(
                "SELECT * FROM idempotency_records ORDER BY idempotency_key"
            )
        ]
    return json.dumps(
        {"objects": objects, "operations": operations, "idempotency": idem},
        sort_keys=True,
    )


def operation_rows(db: Path) -> list[tuple]:
    with sqlite3.connect(db) as conn:
        conn.row_factory = sqlite3.Row
        return [
            (
                r["operation_id"],
                r["operation_name"],
                r["arguments_json"],
                int(r["expected_world_revision"]),
                r["reason"],
                r["idempotency_key"],
                r["status"],
                r["result_world_revision"],
            )
            for r in conn.execute("SELECT * FROM operations ORDER BY idempotency_key")
        ]


def idempotency_rows(db: Path) -> list[tuple]:
    with sqlite3.connect(db) as conn:
        conn.row_factory = sqlite3.Row
        return [
            (r["idempotency_key"], r["operation_id"], int(r["world_revision"]), r["result_json"])
            for r in conn.execute("SELECT * FROM idempotency_records ORDER BY idempotency_key")
        ]


def object_revisions(db: Path, object_type: ObjectType) -> list[tuple[str, int]]:
    store, _index = world(db)
    return sorted(
        (str(p["object_id"]), int(p["revision"]))
        for p in store.list_payloads(object_type=object_type, subject_id=None)
    )


def object_digests(db: Path, object_type: ObjectType) -> dict[tuple[str, int], str]:
    """(object_id, revision) -> payload digest, for exact overwrite detection."""
    store, _index = world(db)
    return {
        (str(p["object_id"]), int(p["revision"])): hashlib.sha256(
            json.dumps(p, sort_keys=True, default=str).encode()
        ).hexdigest()
        for p in store.list_payloads(object_type=object_type, subject_id=None)
    }


def invoke(rt: FusedTurnRuntime, name: str, arguments: Mapping[str, Any], *, call_id: str = "corrective-0"):
    """Invoke a capability at the stable recovered write time."""
    rt._active_turn_time = T
    if name == "commit_operation_experience":
        rt._active_review_request = PeriodicReviewRequest(
            review_id="corrective001-review",
            subject_id=SUBJECT,
            wake_ref=ObjectRef(object_id="corrective001-review-wake", revision=1),
            window_start=T - timedelta(hours=2),
            window_end=T,
            anchors=(
                ReviewAnchor(
                    object_ref=ObjectRef(object_id=f"leaf_{LEAF}", revision=1),
                    object_type=ObjectType.OBSERVATION.value,
                    recorded_at=T - timedelta(hours=2),
                    excerpt="corrective operation-experience anchor",
                ),
            ),
        )
    try:
        return rt.registry.invoke(CapabilityCall(name=name, call_id=call_id, arguments=dict(arguments)))
    finally:
        rt._active_turn_time = None
        rt._active_review_request = None


def ref(payload: Mapping[str, Any]) -> dict[str, Any]:
    return {"object_id": str(payload["object_id"]), "revision": int(payload["revision"])}


# --------------------------------------------------------------------------- #
# frozen capability replay matrix
# --------------------------------------------------------------------------- #
@dataclass(frozen=True)
class Scenario:
    """One frozen row of the capability replay matrix.

    ``prepare`` runs once on the applying runtime and returns the exact capability
    arguments. ``identity`` names the durable object type whose object/revision
    identity must be preserved by an identical replay. ``primary`` is the path
    into the capability result data that holds the primary durable object id.

    Two conflict classes are frozen, because they are genuinely different
    contracts and conflating them produces a false RED:

    ``conflicts``
        Mutations of fields that are NOT part of the stable object identity, so
        the durable idempotency key is unchanged. A changed request under an
        existing key MUST fail closed.
    ``identity_shifts``
        Mutations of fields that ARE inputs to the deterministic object id, so
        the request is a different logical object with a different key. It must
        never be conflated with, or silently overwrite, the original object.
    """

    name: str
    prepare: Callable[[FusedTurnRuntime], dict[str, Any]]
    identity: ObjectType
    family: str
    primary: tuple[str, ...]
    conflicts: tuple[tuple[str, Callable[[dict[str, Any]], dict[str, Any]]], ...] = ()
    identity_shifts: tuple[tuple[str, Callable[[dict[str, Any]], dict[str, Any]]], ...] = ()
    notes: str = ""


def _mutate(key: str, value: Any) -> Callable[[dict[str, Any]], dict[str, Any]]:
    def apply(arguments: dict[str, Any]) -> dict[str, Any]:
        changed = dict(arguments)
        changed[key] = value
        return changed

    return apply


def _mutate_evidence() -> Callable[[dict[str, Any]], dict[str, Any]]:
    """Cite different but equally real evidence (same key for identity-open objects)."""

    def apply(arguments: dict[str, Any]) -> dict[str, Any]:
        changed = dict(arguments)
        changed["evidence_refs"] = [leaf_ref(OTHER_LEAF)]
        return changed

    return apply


def _mutate_ref_revision(key: str) -> Callable[[dict[str, Any]], dict[str, Any]]:
    def apply(arguments: dict[str, Any]) -> dict[str, Any]:
        changed = dict(arguments)
        target = dict(changed[key])
        target["revision"] = int(target["revision"]) + 1
        changed[key] = target
        return changed

    return apply


def _mutate_ref_identity(key: str) -> Callable[[dict[str, Any]], dict[str, Any]]:
    def apply(arguments: dict[str, Any]) -> dict[str, Any]:
        changed = dict(arguments)
        target = dict(changed[key])
        target["object_id"] = str(target["object_id"])[:-4] + "dead"
        changed[key] = target
        return changed

    return apply


def _mutate_first_evidence_revision() -> Callable[[dict[str, Any]], dict[str, Any]]:
    def apply(arguments: dict[str, Any]) -> dict[str, Any]:
        changed = dict(arguments)
        refs = [dict(item) for item in changed["evidence_refs"]]
        refs[0]["revision"] = int(refs[0]["revision"]) + 1
        changed["evidence_refs"] = refs
        return changed

    return apply


