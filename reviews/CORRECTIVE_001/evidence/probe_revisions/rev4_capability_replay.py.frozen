def prep_revise_entity(rt: FusedTurnRuntime) -> dict[str, Any]:
    entity = rt.store.get_payload(
        [
            p["object_id"]
            for p in rt.store.list_payloads(object_type=ObjectType.ENTITY, subject_id=SUBJECT)
            if p.get("metadata", {}).get("entity_key") == "entity:revise-seed"
        ][0]
    )
    return {
        "entity_ref": ref(entity),
        "reason": "corrective entity revision reason",
        "evidence_refs": [leaf_ref(LEAF)],
        "canonical_name": "Revised Corrective Entity",
    }


def prep_upsert_relation(rt: FusedTurnRuntime) -> dict[str, Any]:
    entities = {
        str(p.get("metadata", {}).get("entity_key")): p
        for p in rt.store.list_payloads(object_type=ObjectType.ENTITY, subject_id=SUBJECT)
    }
    left = entities["entity:relation-left"]
    right = entities["entity:relation-right"]
    return {
        "left_ref": ref(left),
        "relation_type": "related_to",
        "right_ref": ref(right),
        "evidence_refs": [leaf_ref(LEAF)],
        "confidence": 0.8,
        "reason": "corrective relation reason",
    }


