SCENARIOS: tuple[Scenario, ...] = (
    Scenario(
        name="create_attention_watch",
        prepare=prep_create_attention_watch,
        identity=ObjectType.TASK,
        family="create",
        primary=("task_id",),
        conflicts=(
            ("changed priority", _mutate("priority", 77)),
            ("changed cooldown", _mutate("cooldown_seconds", 600)),
            ("changed dimensions", _mutate("dimensions", ["dim:corrective001-other"])),
        ),
        identity_shifts=(("changed title", _mutate("title", "changed watch")),),
    ),
    Scenario(
        name="create_task",
        prepare=prep_create_task,
        identity=ObjectType.TASK,
        family="create",
        primary=("task_id",),
        conflicts=(
            ("changed priority", _mutate("priority", 77)),
            ("changed next_step", _mutate("next_step", "changed next step")),
        ),
        identity_shifts=(("changed title", _mutate("title", "changed task")),),
    ),
    Scenario(
        name="commit_claim",
        prepare=prep_commit_claim,
        identity=ObjectType.CLAIM,
        family="create",
        primary=("claim_id",),
        # claim_id is a hash of the complete canonical request, so no changed
        # field can reuse the same idempotency key. Identity shifts only.
        identity_shifts=(
            ("changed content", _mutate("content", "changed claim")),
            ("changed confidence", _mutate("confidence", 0.11)),
            ("changed evidence", _mutate_evidence()),
        ),
        notes="identity-complete object id; same-key changed request unreachable",
    ),
    Scenario(
        name="commit_ai_world_claim",
        prepare=prep_commit_ai_world_claim,
        identity=ObjectType.CLAIM,
        family="create",
        primary=("claim", "claim_id"),
        identity_shifts=(
            ("changed statement", _mutate("statement", "changed statement")),
            ("changed confidence", _mutate("confidence", 0.11)),
        ),
        notes="identity-complete object id; same-key changed request unreachable",
    ),
    Scenario(
        name="propose_entity",
        prepare=prep_propose_entity,
        identity=ObjectType.ENTITY,
        family="create",
        primary=("entity_id",),
        conflicts=(
            ("changed canonical name", _mutate("canonical_name", "Different Entity")),
            ("changed entity kind", _mutate("entity_kind", "organization")),
            ("changed evidence", _mutate_evidence()),
        ),
        identity_shifts=(("changed entity key", _mutate("entity_key", "entity:other")),),
    ),
    Scenario(
        name="revise_entity",
        prepare=prep_revise_entity,
        identity=ObjectType.ENTITY,
        family="revise",
        primary=("entity_id",),
        conflicts=(
            ("changed reason", _mutate("reason", "different revision reason")),
            ("changed canonical name", _mutate("canonical_name", "Another Revision")),
            ("changed evidence", _mutate_evidence()),
        ),
        identity_shifts=(("changed target revision", _mutate_ref_revision("entity_ref")),),
    ),
    Scenario(
        name="upsert_relation",
        prepare=prep_upsert_relation,
        identity=ObjectType.RELATION,
        family="revise",
        primary=("relation_id",),
        conflicts=(
            ("changed confidence", _mutate("confidence", 0.11)),
            ("changed reason", _mutate("reason", "different relation reason")),
            ("changed evidence", _mutate_evidence()),
        ),
        identity_shifts=(
            ("changed relation type", _mutate("relation_type", "part_of")),
            ("changed left endpoint", _mutate_ref_identity("left_ref")),
        ),
    ),
    Scenario(
        name="propose_dimension",
        prepare=prep_propose_dimension,
        identity=ObjectType.DIMENSION_DEFINITION,
        family="create",
        primary=("dimension_id",),
        conflicts=(
            ("changed description", _mutate("description", "changed description")),
            ("changed data shape", _mutate("data_shape", "series")),
            ("changed evidence", _mutate_evidence()),
        ),
        identity_shifts=(
            ("changed dimension key", _mutate("dimension_key", "dim:corrective001_other")),
        ),
    ),
    Scenario(
        name="transition_dimension",
        prepare=prep_transition_dimension,
        identity=ObjectType.DIMENSION_DEFINITION,
        family="transition",
        primary=("dimension_id",),
        conflicts=(
            ("changed reason", _mutate("reason", "different dimension reason")),
            ("changed evidence", _mutate_evidence()),
        ),
        identity_shifts=(("changed target", _mutate("new_lifecycle", "rejected")),),
    ),
    Scenario(
        name="propose_goal",
        prepare=prep_propose_goal,
        identity=ObjectType.GOAL,
        family="create",
        primary=("goal_id",),
        conflicts=(
            ("changed confidence", _mutate("confidence", 0.11)),
            ("changed criteria", _mutate("success_criteria", ["criterion-b"])),
        ),
        identity_shifts=(
